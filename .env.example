# Local development. Copy to .env.local and fill privately; never commit real values.
PORT=4317
APP_URL=http://127.0.0.1:4317
# Generate a random high-entropy value; keep it stable to retain workspace sessions.
APP_SESSION_SECRET=

# Managed voice and configured account-side agents/extractions.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_COACH_AGENT_ID=
BOLNA_FOLLOWUP_AGENT_ID=
# Optional legacy analysis path when INFERENCE_URL is absent.
BOLNA_ANALYST_AGENT_ID=

# Human browser-to-phone calling. Configure the dedicated application's answer URL
# against the deployed HTTPS APP_URL. No master provider credentials go to the browser.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_APP_ID=
VOBIZ_CALLER_ID=
VOBIZ_WEBHOOK_SECRET=

# Optional locally: without a token, state uses private local JSON files.
# Required for durable hosted state; connect a PRIVATE Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Enable only after checking provider credit, agent duration and trial restrictions.
# Shared hosted operation limits are defined in server/api.mjs.
CALLING_ENABLED=false

# Legacy fixed-recipient CallingService harness only; not the workspace call form.
BOLNA_FROM_NUMBER=
TEST_PHONE_NUMBER=
MAX_TEST_CALLS=3

# Dedicated structured intelligence (server-only; see inference/README.md).
# Production uses Workers AI. A configured bridge error never falls back silently.
INFERENCE_URL=
INFERENCE_SECRET=
